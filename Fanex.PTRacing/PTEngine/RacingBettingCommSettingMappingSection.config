    <add Type="Out" TargetRoleId="0" MappingTarget="MaxBetMax" Pattern="{SportId}maxbet_{BetTypeId}_max" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
      <BetTypeId Format="{0}" OmitWhenDefault="0"></BetTypeId>
    </add>
    <add Type="Out" TargetRoleId="0" MappingTarget="MaxPerMatchMax" Pattern="{SportId}maxpermatch_{BetTypeId}_max" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
