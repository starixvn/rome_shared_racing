<?xml version="1.0" encoding="utf-8" ?>
<RacingBettingCommSettingMappingSection>
  <BettingCommSettingMapping>
    <!--Common Forms-->
    <!--in parameters-->
    <add Type="In" TargetRoleId="0" MappingTarget="MinBet" Pattern="{SportId}minbet_{BetTypeId}" >
      <SportId Format="v{0}" OmitWhenDefault="1"></SportId>
      <BetTypeId Format="{0}" OmitWhenDefault="0"></BetTypeId>
    </add>
    <add Type="In" TargetRoleId="0" MappingTarget="MaxBet" Pattern="{SportId}maxbet_{BetTypeId}" >
